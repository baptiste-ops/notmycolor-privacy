  <link href="https://api.fontshare.com/v2/css?f[]=aeonik@400,500,700,900&display=swap" rel="stylesheet" />

  <style>
    :root {
      --bg: #0a0a0a;
      --white: #ffffff;
      --muted: rgba(255,255,255,0.58);
      --soft: rgba(255,255,255,0.08);
      --border: rgba(255,255,255,0.12);
      --maxw: 1100px;
    }

    * { box-sizing: border-box; }

    html, body {
      margin: 0;
      padding: 0;
      background: var(--bg);
      color: var(--white);
      font-family: "Aeonik", -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
      overflow-x: hidden;
      scroll-behavior: smooth;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .blob-bg {
      position: fixed;
      inset: 0;
      z-index: -2;
      overflow: hidden;
      background: #0a0a0a;
    }

    .blob {
      position: absolute;
      width: 55vmax;
      height: 55vmax;
      border-radius: 50%;
      filter: blur(90px);
      opacity: 0.5;
      mix-blend-mode: screen;
      animation: float 18s ease-in-out infinite;
    }

    .blob.a {
      top: -12vmax;
      left: -12vmax;
      background: radial-gradient(circle, #6600ff 0%, transparent 60%);
    }

    .blob.b {
      bottom: -14vmax;
      right: -12vmax;
      background: radial-gradient(circle, #ff2d88 0%, transparent 60%);
      animation-delay: -6s;
    }

    .blob.c {
      top: 35vh;
      left: 35vw;
      background: radial-gradient(circle, #00c8ff 0%, transparent 60%);
      opacity: 0.35;
      animation-delay: -10s;
    }

    @keyframes float {
      0%, 100% { transform: translate3d(0,0,0) scale(1); }
      50% { transform: translate3d(10vw,8vh,0) scale(1.15); }
    }

    .vignette {
      position: fixed;
      inset: 0;
      z-index: -1;
      background:
        radial-gradient(ellipse at center, transparent 0%, rgba(0,0,0,0.45) 75%, rgba(0,0,0,0.75) 100%),
        linear-gradient(to bottom, rgba(10,10,10,0.2), rgba(10,10,10,0.75));
      pointer-events: none;
    }

    .nav {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 20;
      padding: 18px 24px;
    }

    .nav-inner {
      max-width: var(--maxw);
      margin: 0 auto;
      padding: 14px 18px 14px 24px;
      border-radius: 999px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: rgba(16,16,18,0.55);
      border: 1px solid rgba(255,255,255,0.08);
      backdrop-filter: blur(20px);
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 11px;
      font-weight: 900;
      font-size: 17px;
    }

    .brand img {
      width: 36px;
      height: 36px;
      display: block;
    }

    .nav-cta,
    .btn-primary {
      background: white;
      color: black;
      border-radius: 999px;
      font-weight: 800;
      transition: transform 0.18s ease;
      white-space: nowrap;
    }

    .nav-cta {
      padding: 10px 16px;
      font-size: 13px;
    }

    .nav-cta:hover,
    .btn-primary:hover {
      transform: scale(1.03);
    }

    section {
      position: relative;
      padding: 100px 24px;
    }

    .container {
      max-width: var(--maxw);
      margin: 0 auto;
    }

    .hero {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding-top: 130px;
    }

    .hero-inner {
      max-width: 900px;
      margin: 0 auto;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 14px;
      border-radius: 999px;
      background: var(--soft);
      border: 1px solid var(--border);
      color: rgba(255,255,255,0.84);
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.18em;
      margin-bottom: 28px;
    }

    .badge-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #29cc57;
      box-shadow: 0 0 8px rgba(41,204,87,0.8);
    }

    h1, h2, h3 {
      margin: 0;
      font-weight: 900;
      letter-spacing: -0.035em;
      line-height: 1.04;
    }

    h1 {
      font-size: clamp(42px, 8.5vw, 86px);
      margin-bottom: 22px;
    }

    h2 {
      font-size: clamp(34px, 6vw, 58px);
      margin-bottom: 18px;
      text-align: center;
    }

    h3 {
      font-size: 24px;
      margin-bottom: 10px;
    }

    p {
      color: var(--muted);
      font-size: 17px;
      line-height: 1.6;
    }

    .gradient-text {
      background: linear-gradient(90deg, #ff6bff 0%, #ffc46b 50%, #6bcbff 100%);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      color: transparent;
    }

    .hero-sub {
      max-width: 660px;
      margin: 0 auto 38px;
      font-size: clamp(16px, 1.8vw, 20px);
    }

    .cta-row {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 12px;
    }

    .btn-primary {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 18px 32px;
      font-size: 16px;
    }

    .cta-hint {
      font-size: 13px;
      color: rgba(255,255,255,0.42);
    }

    .section-head {
      max-width: 720px;
      margin: 0 auto 56px;
      text-align: center;
    }

    .eyebrow {
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: rgba(255,255,255,0.45);
      margin-bottom: 16px;
    }

    .phone-wrap {
      display: flex;
      justify-content: center;
      align-items: center;
      margin-top: 50px;
    }

    .phone-frame {
      width: min(340px, 82vw);
      aspect-ratio: 9 / 18.6;
      border-radius: 56px;
      overflow: hidden;
      background: #111;
      box-shadow:
        0 30px 80px rgba(108,0,255,0.35),
        0 60px 120px rgba(0,200,255,0.15);
    }

    .phone-frame video {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center top;
      display: block;
    }

    .color-band {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      gap: 12px;
      max-width: 900px;
      margin: 40px auto 0;
    }

    .swatch {
      aspect-ratio: 1 / 1.25;
      border-radius: 20px;
      box-shadow: inset 0 0 0 1px rgba(255,255,255,0.08);
    }

    .swatch:nth-child(1) { background: #5d2e0f; }
    .swatch:nth-child(2) { background: #2e4d2a; }
    .swatch:nth-child(3) { background: #6e1a1a; }
    .swatch:nth-child(4) { background: #3e2723; }
    .swatch:nth-child(5) { background: #704214; }
    .swatch:nth-child(6) { background: #edc9af; }

    .steps,
    .bento {
      display: grid;
      grid-template-columns: 1fr;
      gap: 16px;
    }

    @media (min-width: 768px) {
      .steps {
        grid-template-columns: repeat(3, 1fr);
      }

      .bento {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    .card,
    .tile {
      padding: 30px;
      background: rgba(255,255,255,0.055);
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 24px;
      backdrop-filter: blur(14px);
    }

    .problem {
      text-align: center;
    }

    .problem p {
      font-size: clamp(28px, 5vw, 58px);
      font-weight: 900;
      letter-spacing: -0.04em;
      line-height: 1.18;
      color: white;
      margin: 16px auto;
      max-width: 960px;
    }

    .promise-inline {
      max-width: 760px;
      margin: 0 auto 70px;
      text-align: center;
    }

    .promise-inline blockquote {
      margin: 0;
      font-size: clamp(20px, 3vw, 28px);
      line-height: 1.45;
      color: rgba(255,255,255,0.68);
      font-style: italic;
    }

    .promise-inline cite {
      display: block;
      margin-top: 18px;
      color: rgba(255,255,255,0.38);
      font-style: normal;
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }

    .faq-list {
      max-width: 760px;
      margin: 0 auto;
      border-top: 1px solid var(--border);
    }

    details {
      border-bottom: 1px solid var(--border);
      padding: 22px 4px;
    }

    summary {
      cursor: pointer;
      list-style: none;
      font-size: 18px;
      font-weight: 800;
    }

    summary::-webkit-details-marker {
      display: none;
    }

    details div {
      margin-top: 14px;
      color: var(--muted);
      font-size: 15px;
      line-height: 1.6;
    }

    footer {
      padding: 56px 24px calc(40px + env(safe-area-inset-bottom));
      border-top: 1px solid var(--border);
      text-align: center;
    }

    .footer-inner {
      max-width: var(--maxw);
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 22px;
    }

    .footer-links {
      display: flex;
      gap: 16px;
      flex-wrap: wrap;
      justify-content: center;
      color: var(--muted);
      font-size: 14px;
    }

    .copyright {
      color: rgba(255,255,255,0.35);
      font-size: 12px;
      letter-spacing: 0.08em;
      font-weight: 700;
    }

    @media (max-width: 640px) {
      .nav-cta {
        padding: 9px 12px;
        font-size: 12px;
      }

      .brand span:last-child {
        display: none;
      }

      .color-band {
        gap: 8px;
      }

      .card,
      .tile {
        padding: 22px;
      }
    }
  </style>
</head>

